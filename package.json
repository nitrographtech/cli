{
  "name": "nitrograph",
  "version": "0.7.0",
  "description": "One API. 11,000+ services. Discover, rank, and call APIs from MCP, CLI, plugins, and TypeScript.",
  "type": "module",
  "bin": {
    "nitrograph": "dist/index.js"
  },
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "files": [
    "dist",
    "skills",
    ".mcp.json",
    "assets/nitrograph-hero.svg",
    "assets/nitrograph-icon.svg",
    "assets/nitrograph-logo.svg",
    "assets/nitrograph-readme-demo.gif",
    ".codex-plugin",
    ".agents/plugins/marketplace.json",
    "server.json",
    "CODEX_PLUGIN.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prebuild": "node scripts/check-lib-version.mjs",
    "check:version": "node scripts/check-lib-version.mjs",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "nitrograph",
    "service-discovery",
    "api-discovery",
    "tool-discovery",
    "service-registry",
    "agent-commerce",
    "agent-commerce-search",
    "api-marketplace",
    "agent-tools",
    "agent",
    "codex-plugin",
    "paid-apis",
    "x402",
    "mpp",
    "skills"
  ],
  "author": "Nitrograph",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitrographtech/cli.git"
  },
  "bugs": {
    "url": "https://github.com/nitrographtech/cli/issues"
  },
  "homepage": "https://nitrograph.com",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=20.6",
      "onFail": "warn"
    }
  }
}
